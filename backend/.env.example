BACKBOARD_API_KEY=
APIFY_TOKEN=
GPTZERO_API_KEY=
# Optional: Claude rewrites the evidence as a short brief. Empty uses the built-in template.
ANTHROPIC_API_KEY=
# Exact extension origin for production, comma separated. Local browser preview is allowed by default.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set the ID printed at chrome://extensions (32 lowercase letters a-p).
EXTENSION_ID=
PROVIDER_TIMEOUT=45
CACHE_TTL=900
